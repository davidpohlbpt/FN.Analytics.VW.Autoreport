# Copy to .env and fill in real values. NEVER commit .env.
# In AWS Lambda these values are set by deployment/template.yaml; secrets come from
# Secrets Manager and are injected into the environment (pycore EnvVault reads env vars).

# ----------------------------- pycore resources ----------------------------- #
# LOCAL  -> SQL Server via pyodbc, FileStorage under LOCAL_BLOB_DIR, EnvVault
# MEMORY -> in-memory SQLite + temp storage (unit tests)
resource_type = "LOCAL"
app_name = "VwAutoreport"
app_db_name = "ReportDB"

# --------------------------------- Database --------------------------------- #
# SQL login against the DQN SQL Server. ODBC Driver 18 is installed in the Lambda image.
local_sqlserver_db = "ReportDB"
local_sqlserver_conn_str = "Driver={ODBC Driver 18 for SQL Server};Server=<host>,1433;Database=ReportDB;Uid=<user>;Pwd=<password>;Encrypt=yes;TrustServerCertificate=yes;"

# Recipient table for the KPI deck process
recipients_schema = "control"
recipients_table = "T_CONTROL_Autoreport_Recipients"

# ------------------------------- Blob storage ------------------------------- #
# Local folder emulating blob containers. In Lambda this must be under /tmp.
local_blob_dir = "C:\\path\\to\\autoreport_data"
storage_container = "ppt_creator"
template_file_name = "VW_Template_Overview.pptx"

# --------------------------- Config Center / DQN ---------------------------- #
# Host only, no scheme. Used as {REQUEST_URL} in pptcreator/configs/endpoints.py
base_request_url = "<dqn-host>"
endpointbasepath = "https://<dqn-host>"

# DQN API login (pptcreator/utils/get_session.py)
username = "<dqn-api-username>"
password = "<dqn-api-password>"

# ----------------------------------- AWS ------------------------------------ #
# AWS_REGION is reserved inside Lambda, therefore a separate name
aws_region_name = "eu-central-1"

# S3: template download + report upload. Disable for pure local runs.
s3_enabled = "false"
s3_bucket = "<bucket-name>"
s3_template_key = "templates/VW_Template_Overview.pptx"
s3_output_prefix = "reports"

# SES: disable to skip sending (deck is still rendered).
mail_enabled = "false"
ses_sender = "reporting@example.com"
ses_recipients_mode = "bcc"

# --------------------------------- Report ----------------------------------- #
report_language = "DE"
commodity_charts_per_slide = "7"
# stub -> deterministic dummy data, sql -> DQN KPI table (pending schema)
kpi_source = "stub"
