# Copy to .env and fill in real values. NEVER commit .env.
# In AWS these values should come from Secrets Manager / SSM, not from a file.

# ----------------------------- Resource backend ----------------------------- #
# AZURE | LOCAL
resource_type = "AZURE"

# --------------------------------- Database --------------------------------- #
local_sqlserver_db = "ReportDB"
local_sqlserver_conn_str = "Driver={ODBC Driver 17 for SQL Server};Server=localhost\\SQLEXPRESS;Database=MasterDataDB;Trusted_Connection=yes;"

# ------------------------------- Blob storage ------------------------------- #
local_blob_dir = "C:\\path\\to\\ppt_creator_data"

# --------------------------- Config Center / DQN ---------------------------- #
# Host only, no scheme. Used as {REQUEST_URL} in pptcreator/configs/endpoints.py
base_request_url = "man.factorynavigator.de"
endpointbasepath = "https://man.factorynavigator.de"

# DQN API login (pptcreator/utils/get_session.py)
username = "<dqn-api-username>"
password = "<dqn-api-password>"

# ------------------------------- Key Vault ---------------------------------- #
keyvaulturl = "https://<your-keyvault>.vault.azure.net/"
kv_tenant_id = "<tenant-id>"
kv_client_id = "<client-id>"
kv_client_secret = "<client-secret>"
key_vault_conn_str = "App;AppId=<app-id>;TenantId=<tenant-id>;AppKey=<app-key>"

# Environment-scoped vault credentials (optional)
ea_kv_client_id = ""
ea_kv_client_secret = ""
ea_kv_tenant_id = ""

# ------------------------------ E-Mail (Graph) ------------------------------ #
# Secrets read via vault.get_secret(...) -- the names below must exist in the vault
# as: sender_user, tenant_id, client_id, client_secret
sender_user = "reporting@example.com"
tenant_id = "<m365-tenant-id>"
client_id = "<app-registration-client-id>"
client_secret = "<app-registration-client-secret>"
