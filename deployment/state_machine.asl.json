{
  "Comment": "VW Autoreport: plan decks from the recipient table, render and send each deck, then record all outcomes in the run log. ${...} ARNs are substituted by SAM.",
  "StartAt": "Plan",
  "States": {
    "Plan": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PlanFunctionArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "run_id.$": "$.Payload.run_id",
        "trigger.$": "$.Payload.trigger",
        "count.$": "$.Payload.count",
        "template_ids.$": "$.Payload.template_ids",
        "errors.$": "$.Payload.errors",
        "requests.$": "$.Payload.requests"
      },
      "ResultPath": "$.plan",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "AnyDecks"
    },
    "AnyDecks": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.plan.count",
          "NumericGreaterThan": 0,
          "Next": "Decks"
        }
      ],
      "Default": "NothingToDo"
    },
    "NothingToDo": {
      "Type": "Succeed"
    },
    "Decks": {
      "Type": "Map",
      "ItemsPath": "$.plan.requests",
      "MaxConcurrency": 2,
      "ResultPath": "$.decks",
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "Render",
        "States": {
          "Render": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${RenderFunctionArn}",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "TimeoutSeconds": 900,
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                "IntervalSeconds": 10,
                "MaxAttempts": 2,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "RenderFailed"
              }
            ],
            "Next": "Send"
          },
          "Send": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${SendFunctionArn}",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": ["States.ALL"],
                "IntervalSeconds": 30,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "SendFailed"
              }
            ],
            "End": true
          },
          "RenderFailed": {
            "Type": "Pass",
            "Parameters": {
              "status": "failed",
              "step": "render",
              "request": {
                "run_id.$": "$.run_id",
                "template_id.$": "$.template_id",
                "brand.$": "$.brand",
                "current_period.$": "$.current_period",
                "reference_period.$": "$.reference_period",
                "recipients.$": "$.recipients"
              },
              "error.$": "$.error"
            },
            "End": true
          },
          "SendFailed": {
            "Type": "Pass",
            "Parameters": {
              "status": "failed",
              "step": "send",
              "request.$": "$.request",
              "error.$": "$.error"
            },
            "End": true
          }
        }
      },
      "Next": "Record"
    },
    "Record": {
      "Type": "Task",
      "Comment": "Writes the outcome of every deck to the run log; the send Lambda has no database access.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${RecordFunctionArn}",
        "Payload": {
          "run_id.$": "$.plan.run_id",
          "results.$": "$.decks"
        }
      },
      "ResultSelector": {
        "recorded.$": "$.Payload.recorded",
        "sent.$": "$.Payload.sent",
        "skipped.$": "$.Payload.skipped",
        "failed.$": "$.Payload.failed"
      },
      "ResultPath": "$.summary",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "End": true
    }
  }
}
